---
// Wspólny nagłówek podstron (recenzja, cykl): logo, link „Wszystkie książki”, przełącznik języka.
import LangSwitcher from './LangSwitcher.astro';
import T from './T.astro';
---

<div class="rr-header">
  <div class="rr-header-left">
    <a href="/" class="rr-logo">
      <span class="rr-logo-badge"><span class="rr-logo-badge-inner">R</span></span>
      <span class="rr-logo-name"><T k="siteName" /></span>
    </a>
    <span class="rr-header-sep"></span>
    <a href="/" class="rr-back-link">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline>
      </svg>
      <T k="allBooks" />
    </a>
  </div>
  <div class="rr-lang-slot"><LangSwitcher /></div>
</div>

<style>
  .rr-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: nowrap;
    margin-bottom: 26px;
  }
  .rr-header-left {
    display: flex;
    align-items: center;
    gap: 13px;
    min-width: 0;
  }
  .rr-lang-slot {
    flex-shrink: 0;
  }
  .rr-logo {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    text-decoration: none;
    color: inherit;
    flex-shrink: 0;
  }
  .rr-logo-badge {
    width: 28px;
    height: 28px;
    border-radius: 8px;
    padding: 2px;
    display: grid;
    place-items: center;
    flex-shrink: 0;
    background: conic-gradient(from 180deg, #a78bfa, #ec4899, #f59e0b, #10b981, #a78bfa);
  }
  .rr-logo-badge-inner {
    width: 100%;
    height: 100%;
    border-radius: 6px;
    background: #fff;
    display: grid;
    place-items: center;
    color: #16151d;
    font-family: var(--rr-sans);
    font-weight: 700;
    font-size: 14px;
  }
  .rr-logo-name {
    font-family: var(--rr-sans);
    font-weight: 700;
    font-size: 16px;
    letter-spacing: -0.02em;
  }
  .rr-header-sep {
    width: 1px;
    height: 20px;
    background: var(--rr-line-2);
    flex-shrink: 0;
  }
  .rr-back-link {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    min-width: 0;
    text-decoration: none;
    font-family: var(--rr-mono);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--rr-muted);
  }
  .rr-back-link svg {
    flex-shrink: 0;
  }
  .rr-back-link :global(span) {
    overflow: hidden;
    white-space: nowrap;
    text-overflow: ellipsis;
    min-width: 0;
  }
</style>
